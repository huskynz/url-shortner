# URL Shortener (.NET 10) configuration.
# ASP.NET Core maps double-underscore env vars onto nested config keys,
# so e.g. ConnectionStrings__Postgres overrides ConnectionStrings:Postgres.

# --- Database (replaces the Supabase settings) ---
ConnectionStrings__Postgres="Host=localhost;Port=5432;Database=urlshortener;Username=postgres;Password=postgres"

# Apps apply the embedded schema.sql automatically on startup (idempotent). Set false to skip.
Database__AutoMigrate="true"

# One-off Supabase -> local data migration (used by UrlShortener.Migrator only).
# SOURCE_CONNECTION="Host=db.<ref>.supabase.co;Port=5432;Database=postgres;Username=postgres;Password=***;SSL Mode=Require;Trust Server Certificate=true"

# Table names (defaults match the imported Supabase schema).
# Legacy equivalents: SUPABASE_DB_NAME -> UrlsTable, ADMINS_DB -> AdminsTable, APIKEY_DB -> ApiKeysTable
UrlShortener__UrlsTable="urls"
UrlShortener__AdminsTable="github_admins"
UrlShortener__ApiKeysTable="api_keys"

# --- Caching (replaces Redis; now in-process IMemoryCache) ---
# Redirect cache TTL in seconds. 0 (default) = no caching, so link add/edit/deprecate
# is instant across replicas. Set a positive value only to cache hot paths briefly.
UrlShortener__RedirectCacheTtlSeconds="0"
# Short-lived admin/role lookup cache TTL in seconds.
UrlShortener__AdminCacheTtlSeconds="30"

# --- Analytics (was ADMIN_ANALYTICS_*) ---
UrlShortener__AnalyticsMaxRows="5000"
UrlShortener__AnalyticsBatchSize="1000"

# --- UI labels (were NEXT_PUBLIC_*) ---
UrlShortener__Environment="Production"
UrlShortener__VersionNumber="5.1"
UrlShortener__LogoUrl="https://serv.husky.nz/logo/default.png"

# --- Auth ---
# Cookie domain lets the Admin cookie be shared with the API when both run under
# the same parent domain (e.g. ".husky.nz"). Leave empty for single-host/local.
Auth__CookieDomain=""
# Shared Data Protection key ring path. Point Admin + API at the same mounted
# directory so the API can also validate the Admin-issued cookie. Empty = per-app keys.
DataProtection__KeyRingPath=""

# Removed vs the old Next.js app: GITHUB_*, NEXTAUTH_*, SUPABASE_*, REDIS_*.
