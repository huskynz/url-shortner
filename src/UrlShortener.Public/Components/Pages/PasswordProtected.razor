@page "/password-protected"
@rendermode InteractiveServer
@inject RedirectService Redirect
@inject UrlAdminService Urls
@inject NavigationManager Nav

<PageTitle>Password Protected</PageTitle>

@if (_loading)
{
    <div class="min-h-screen flex items-center justify-center bg-[#0a0a0a]">
        <div class="animate-spin rounded-full h-10 w-10 border-b-2 border-blue-500"></div>
    </div>
}
else if (_urlDetails is not null)
{
    <div class="min-h-screen flex items-center justify-center bg-[#0a0a0a] px-4">
        <div class="max-w-md w-full space-y-8 bg-[#1a1a1a] p-8 rounded-xl border border-gray-800">
            <div class="text-center">
                <div class="mx-auto h-12 w-12 flex items-center justify-center rounded-full bg-blue-500/10">
                    <span class="text-blue-500 text-xl">🔒</span>
                </div>
                <h2 class="mt-6 text-2xl font-bold text-gray-200">Password Protected</h2>
                <p class="mt-2 text-sm text-gray-400">
                    The URL <span class="font-semibold text-gray-300">/@Path</span> is password protected. Please enter the password to continue.
                </p>
            </div>

            <form class="mt-8 space-y-6" @onsubmit="HandleSubmit" @onsubmit:preventDefault @formname="password-protected">
                <div>
                    <input id="password" name="password" type="password" required maxlength="1024" autocomplete="current-password" @bind="_password" @bind:event="oninput"
                           class="appearance-none relative block w-full px-3 py-2 border border-gray-800 rounded-lg bg-[#0a0a0a] text-gray-200 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                           placeholder="Enter password" />
                </div>

                @if (!string.IsNullOrEmpty(_error))
                {
                    <div class="text-sm text-red-500 text-center">@_error</div>
                }

                <div>
                    <button type="submit" disabled="@_submitting"
                            class="group relative w-full flex justify-center py-2 px-4 border border-transparent rounded-lg text-sm font-medium text-white bg-blue-500 hover:bg-blue-600 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors">
                        Continue
                    </button>
                </div>
            </form>
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "path")] public string? Path { get; set; }

    private bool _loading = true;
    private Url? _urlDetails;
    private string _password = string.Empty;
    private string _error = string.Empty;
    private bool _submitting;

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrEmpty(Path))
        {
            Nav.NavigateTo("/invaildlink");
            return;
        }

        var data = await Redirect.FetchUrlByShortPathAsync(Path);
        _loading = false;

        if (data is null)
        {
            Nav.NavigateTo("/invaildlink");
            return;
        }
        if (data.Deprecated)
        {
            Nav.NavigateTo($"/deprecated?dpl={Uri.EscapeDataString(Path)}");
            return;
        }
        if (!data.IsPrivate)
        {
            // Never bypass schedule/quota admission through this alternate page.
            Nav.NavigateTo($"/{Uri.EscapeDataString(Path)}", forceLoad: false);
            return;
        }

        _urlDetails = data;
    }

    private async Task HandleSubmit()
    {
        if (_submitting) return;
        _submitting = true;
        _error = string.Empty;
        try
        {
            var result = await Urls.VerifyPasswordAsync(Path, _password);
            if (result.Ok && !string.IsNullOrEmpty(result.Value))
            {
                var external = result.Value.StartsWith("http", StringComparison.OrdinalIgnoreCase);
                Nav.NavigateTo(result.Value, forceLoad: external);
            }
            else
            {
                _error = result.Error ?? "Invalid password";
            }
        }
        finally
        {
            _password = string.Empty;
            _submitting = false;
        }
    }
}
