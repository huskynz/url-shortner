@page "/{Id}"
@using Microsoft.AspNetCore.Http
@inject RedirectService Redirect
@inject IServiceScopeFactory ScopeFactory
@inject IHttpContextAccessor HttpContextAccessor
@inject NavigationManager Nav

@* Catch-all short-path handler. Literal routes (/urls, /deprecated, ...) take
   precedence, so only genuine short paths reach here. Port of src/app/[id]/page.js. *@

@code {
    [Parameter] public string Id { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        // Fire-and-forget visit logging on an independent scope (matches the
        // original which does not block the redirect on logging).
        LogVisitInBackground(Id);

        var payload = await Redirect.FetchRedirectUrlAsync(Id);
        if (payload is null)
        {
            return; // Reserved route (handled by its own page).
        }

        if (payload.Private && payload.RedirectUrl == "/password-protected")
        {
            Nav.NavigateTo($"/password-protected?path={Uri.EscapeDataString(Id)}", forceLoad: false);
            return;
        }

        var target = payload.RedirectUrl;
        var external = target.StartsWith("http://", StringComparison.OrdinalIgnoreCase)
                       || target.StartsWith("https://", StringComparison.OrdinalIgnoreCase);
        Nav.NavigateTo(target, forceLoad: external);
    }

    private void LogVisitInBackground(string location)
    {
        var ctx = HttpContextAccessor.HttpContext;
        var ip = ctx?.Request.Headers["x-forwarded-for"].FirstOrDefault()
                 ?? ctx?.Connection.RemoteIpAddress?.ToString();
        var userAgent = ctx?.Request.Headers.UserAgent.ToString();

        _ = Task.Run(async () =>
        {
            try
            {
                using var scope = ScopeFactory.CreateScope();
                var logger = scope.ServiceProvider.GetRequiredService<VisitLogger>();
                await logger.LogUserDataAsync(location, ip, userAgent);
            }
            catch
            {
                // Visit logging is best-effort.
            }
        });
    }
}
