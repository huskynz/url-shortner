<div class="relative border border-[#303030] bg-[#111111] p-3">
    <div class="flex items-start justify-between">
        <div>
            <p class="text-[11px] uppercase tracking-[0.2em] text-slate-500">@Label</p>
            <p class="text-3xl font-semibold text-[#f0f0f0] mt-1">@Value</p>
            @if (!string.IsNullOrEmpty(Detail))
            {
                <p class="text-sm text-slate-400 mt-1">@Detail</p>
            }
        </div>
        <div class="p-2 border border-[#3a3a3a] text-[#e6e6e6]">@Icon</div>
    </div>
</div>

@code {
    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public string? Detail { get; set; }
    [Parameter] public string Icon { get; set; } = string.Empty;
}
