@page "/set-password"
@rendermode InteractiveServer
@attribute [Authorize(Policy = AuthConstants.SelfServicePolicy)]
@inject AdminService Admins
@inject NavigationManager Nav
@using System.Security.Claims

<PageTitle>Set Email &amp; Password</PageTitle>

<div class="min-h-screen flex items-center justify-center bg-[#0a0a0a]">
    <div class="w-full max-w-md bg-[#111] border border-gray-800 rounded-lg p-8">
        <h1 class="text-2xl font-bold text-gray-200 mb-4">Set Email &amp; Password</h1>
        <p class="text-gray-400 mb-6">Update your own account. If you already have a password, enter it to confirm the change.</p>
        <EditForm Model="this" OnValidSubmit="HandleSubmit" FormName="set-password">
            <div class="space-y-4">
                <div>
                    <label class="block text-sm text-gray-400 mb-1">Current password</label>
                    <input type="password" @bind="_currentPassword" autocomplete="current-password"
                           class="w-full p-2 rounded-lg bg-[#0a0a0a] border border-gray-800 text-gray-200 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-colors" />
                </div>
                <div>
                    <label class="block text-sm text-gray-400 mb-1">Email</label>
                    <input type="email" @bind="_email" required autocomplete="email"
                           class="w-full p-2 rounded-lg bg-[#0a0a0a] border border-gray-800 text-gray-200 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-colors" />
                </div>
                <div>
                    <label class="block text-sm text-gray-400 mb-1">Password</label>
                    <input type="password" @bind="_password" required autocomplete="new-password" minlength="@AdminPassword.MinLength" maxlength="@AdminPassword.MaxLength"
                           class="w-full p-2 rounded-lg bg-[#0a0a0a] border border-gray-800 text-gray-200 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-colors" />
                </div>
                <button type="submit" disabled="@_loading"
                        class="w-full bg-blue-500 text-white px-4 py-2 rounded hover:bg-blue-600 transition-colors font-semibold">
                    @(_loading ? "Saving..." : "Set Email & Password")
                </button>
            </div>
        </EditForm>
        @if (_error is not null)
        {
            <div class="mt-4 text-red-500 text-center">@_error</div>
        }
        @if (_success)
        {
            <div class="mt-4 text-green-500 text-center">Email and password set! Please sign in again.</div>
        }
    </div>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private string _email = string.Empty;
    private string _password = string.Empty;
    private string _currentPassword = string.Empty;
    private string? _error;
    private bool _success;
    private bool _loading;

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var state = await AuthState;
            _email = state.User.FindFirstValue(ClaimTypes.Email) ?? string.Empty;
        }
    }

    private async Task HandleSubmit()
    {
        _error = null;
        _loading = true;
        if (AuthState is null)
        {
            _error = "Please sign in again.";
            _loading = false;
            return;
        }
        var state = await AuthState;
        ServiceResult result;
        try
        {
            result = await Admins.SetOwnPasswordAsync(state.User, _email, _password, _currentPassword);
        }
        finally
        {
            _loading = false;
            _password = _currentPassword = string.Empty;
        }
        if (result.Ok)
        {
            _success = true;
            StateHasChanged();
            await Task.Delay(1200);
            Nav.NavigateTo("/signin", forceLoad: true);
        }
        else
        {
            _error = result.Error ?? "Failed to set email and password.";
        }
    }
}
