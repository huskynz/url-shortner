@page "/set-password"
@rendermode InteractiveServer
@attribute [Authorize(Policy = AuthConstants.SelfServicePolicy)]
@inject AdminService Admins
@inject NavigationManager Nav
@inject ILogger<SetPassword> Logger
@using System.Security.Claims

<PageTitle>My account · HuskyNZ URL Shortener Admin</PageTitle>

<div class="admin-auth">
    <AuthStory />
    <main class="admin-auth-main"><div class="admin-auth-card">
        <p class="admin-eyebrow">My account</p>
        <h1>Set Email &amp; Password</h1>
        <p>Update your own account. If you already have a password, enter it to confirm the change.</p>
        <EditForm Model="this" OnValidSubmit="HandleSubmit" FormName="set-password">
            <div class="space-y-4">
                <div>
                    <label class="workspace-field" for="current-password">Current password</label>
                    <input id="current-password" type="password" @bind="_currentPassword" disabled="@_loading" autocomplete="current-password"
                           class="w-full p-2 rounded-lg bg-[#0a0a0a] border border-gray-800 text-gray-200 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-colors" />
                </div>
                <div>
                    <label class="workspace-field" for="account-email">Email</label>
                    <input id="account-email" type="email" @bind="_email" disabled="@_loading" required autocomplete="email"
                           class="w-full p-2 rounded-lg bg-[#0a0a0a] border border-gray-800 text-gray-200 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-colors" />
                </div>
                <div>
                    <label class="workspace-field" for="new-password">Password</label>
                    <input id="new-password" type="password" @bind="_password" disabled="@_loading" required autocomplete="new-password" minlength="@AdminPassword.MinLength" maxlength="@AdminPassword.MaxLength"
                           class="w-full p-2 rounded-lg bg-[#0a0a0a] border border-gray-800 text-gray-200 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-colors" />
                </div>
                <button type="submit" disabled="@_loading"
                        class="button-primary">
                    @(_loading ? "Saving..." : "Set Email & Password")
                </button>
            </div>
        </EditForm>
        @if (_error is not null)
        {
            <div role="alert" class="workspace-alert">@_error</div>
        }
        @if (_success)
        {
            <div role="status" class="workspace-notice">Email and password set! Please sign in again.</div>
        }
        <p class="auth-security-note"><AdminIcon Name="shield" />Saving credentials requires signing in again.</p>
        <a class="workspace-button" href="/admin/dashboard">Back to dashboard</a>
    </div></main>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private string _email = string.Empty;
    private string _password = string.Empty;
    private string _currentPassword = string.Empty;
    private string? _error;
    private bool _success;
    private bool _loading;

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var state = await AuthState;
            _email = state.User.FindFirstValue(ClaimTypes.Email) ?? string.Empty;
        }
    }

    private async Task HandleSubmit()
    {
        if (_loading) return;
        _error = null;
        _loading = true;
        if (AuthState is null)
        {
            _error = "Please sign in again.";
            _loading = false;
            return;
        }
        var state = await AuthState;
        ServiceResult result;
        try
        {
            result = await Admins.SetOwnPasswordAsync(state.User, _email, _password, _currentPassword);
        }
        catch (Exception ex)
        {
            _error = SafeUiError.Report(ex, Logger, "account.credentials", "Your account could not be updated. Try again or sign in again.");
            return;
        }
        finally
        {
            _loading = false;
            _password = _currentPassword = string.Empty;
        }
        if (result.Ok)
        {
            _success = true;
            StateHasChanged();
            await Task.Delay(1200);
            Nav.NavigateTo("/signin", forceLoad: true);
        }
        else
        {
            _error = result.Error ?? "Failed to set email and password.";
        }
    }
}
