@inherits LayoutComponentBase

@* Auth/sign-in pages render standalone; admin pages wrap themselves in AdminShell. *@
@Body

@* Blazor sets display:block on a real circuit error. Hide initially without
   relying on the Tailwind CDN or a stylesheet this host does not load. *@
<div id="blazor-error-ui" data-nosnippet role="alert" style="display: none">
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
